		ADelay [label=ADelay color=black fillcolor=gold href="#species-ADelay" shape=box style="filled,rounded"]
	}
	subgraph cluster_Urine {
		color=black fillcolor=lightblue fontname=Arial href="#compartment-Urine" label=Urine shape=box style="filled,rounded"
		AUrine [label=AUrine color=black fillcolor=gold href="#species-AUrine" shape=box style="filled,rounded"]
	}
	Alung -> AArt_Plas
	AArt_Plas -> AGut
	AArt_Plas -> ALiv
	AArt_Plas -> AFat
	AArt_Plas -> AKid
	AArt_Plas -> AFil
	AArt_Plas -> ARest
