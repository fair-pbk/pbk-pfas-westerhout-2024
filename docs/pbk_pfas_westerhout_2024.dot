digraph {
	node [fontname=Arial]
	size="7,4"
	ratio=fill
	subgraph cluster_Lung {
		color=black fillcolor=lightblue fontname=Arial href="#compartment-Lung" label=Lung shape=box style="filled,rounded"
		Alung [label=Alung color=black fillcolor=gold href="#species-Alung" shape=box style="filled,rounded"]
	}
	subgraph cluster_Skin {
		color=black fillcolor=lightblue fontname=Arial href="#compartment-Skin" label=Skin shape=box style="filled,rounded"
		ASk [label=ASk color=black fillcolor=gold href="#species-ASk" shape=box style="filled,rounded"]
	}
