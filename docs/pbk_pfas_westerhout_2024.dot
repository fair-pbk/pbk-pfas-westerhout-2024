	}
	subgraph cluster_Fat {
		color=black fillcolor=lightblue fontname=Arial href="#compartment-Fat" label=Fat shape=box style="filled,rounded"
		AFat [label=AFat color=black fillcolor=gold href="#species-AFat" shape=box style="filled,rounded"]
	}
	subgraph cluster_Kid {
		color=black fillcolor=lightblue fontname=Arial href="#compartment-Kid" label=Kid shape=box style="filled,rounded"
		AKid [label=AKid color=black fillcolor=gold href="#species-AKid" shape=box style="filled,rounded"]
	}
	subgraph cluster_Fil {
		color=black fillcolor=lightblue fontname=Arial href="#compartment-Fil" label=Fil shape=box style="filled,rounded"
